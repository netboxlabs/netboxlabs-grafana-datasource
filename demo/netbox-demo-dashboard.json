              "Value": "bps"
            },
            "indexByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "display_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bps"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Recipe 3b \u2014 Flow IPs \u2192 NetBox device identity \u2192 device CPU",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "netboxlabs-datasource",
            "uid": "${DS_NETBOX}"
          },
          "queryType": "ip-enrichment",
          "ips": "$flow_ips",
          "contextFields": [
            "match_count",
            "address_description",
            "interface_name",
            "device_name",
            "is_primary_ip",
            "device_site"
          ],
          "joinKeys": [
            {
              "source": "device_name",
              "output": "device",
              "transform": "none"
            }
          ],
          "limit": 200
        },
        {
          "refId": "P",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "format": "table",
          "instant": true,
          "expr": "device_cpu_percent"
        }
