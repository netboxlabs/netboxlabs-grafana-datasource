# NetBox 4.4 (v1 token era). On 4.5+ switch to a v2 token:
#   API_TOKEN_PEPPER_1=<50+ chars>, SUPERUSER_API_KEY=<12 chars>, SUPERUSER_API_TOKEN=nbt_<key>.<secret> (Bearer)
SECRET_KEY=demodemodemodemodemodemodemodemodemodemodemodemodemo
ALLOWED_HOSTS=*
DB_HOST=postgres
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=netbox
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=redis
REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=false
SKIP_SUPERUSER=false
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=admin
SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567
HOUSEKEEPING_INTERVAL=86400
